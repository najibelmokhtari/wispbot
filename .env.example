# ===========================================
# WhatsApp Group Bot - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Required ---
GEMINI_API_KEY=

# --- Bot Identity ---
BOT_NAME=GeminiAI
BOT_NUMBER=
BOT_USER_ID=

# --- AI Settings ---
# AI_PROVIDER=gemini          # gemini or claude
# AI_MODEL=gemini-2.5-pro
# CLAUDE_API_KEY=

# --- Message History ---
# MESSAGE_HISTORY_LIMIT=20
# EXTENDED_HISTORY_LIMIT=80

# --- Admin Panel ---
# ADMIN_PORT=3000
# ADMIN_HOST=0.0.0.0
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# ADMIN_BASE_PATH=

# --- Google Cloud (for Speech-to-Text) ---
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- TTS (Text-to-Speech) ---
# TTS_TRIGGER=$aa              # Tag users include in messages to request audio response

# --- Background Processor ---
# BACKGROUND_AI_MODEL=gemini-3-flash-preview  # Cheap model for silent message processing
# BACKGROUND_DEBOUNCE_MS=300000               # 5 min inactivity triggers processing
# BACKGROUND_MESSAGE_THRESHOLD=20             # OR this many messages triggers processing
# MEMORIES_DIRECTORY=data/group_memories

# --- Chrome / Puppeteer ---
# CHROME_EXECUTABLE_PATH=               # Path to Chrome binary (auto-detected if not set)

# --- Directories (defaults are usually fine) ---
# DATA_DIRECTORY=data
# IMAGE_DIRECTORY=data/temp_images
# AUDIO_DIRECTORY=data/temp_audio
