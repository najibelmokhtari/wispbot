# ===========================================
# WhatsApp Group Bot - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Required: Gemini credentials (set ONE of these) ---
# Option A: Gemini API key
GEMINI_API_KEY=
# Option B: Google Cloud service account (calls go through Vertex AI)
# GOOGLE_SERVICE_ACCOUNT_FILE=  # Path to a service account key file
# GOOGLE_SERVICE_ACCOUNT_JSON=  # ...or the key JSON inline (takes precedence over the file)
# VERTEX_REGION=global          # Vertex location; newer models like gemini-4-argon need "global"
# GEMINI_AUTH=                  # Force 'api_key' or 'service_account'; empty = service account if set, else API key

# --- Bot Identity ---
BOT_NAME=Wisp

# --- AI Settings ---
# AI_PROVIDER=gemini          # Only 'gemini' is built-in. See src/ai/ to add your own provider.
# AI_MODEL=gemini-4-argon

# --- Message History ---
# MESSAGE_HISTORY_LIMIT=20
# EXTENDED_HISTORY_LIMIT=80

# --- Admin Panel ---
# ADMIN_PORT=3000
# ADMIN_HOST=127.0.0.1          # Set to 0.0.0.0 for Docker or LAN access
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=          # Auto-generated on first run if not set
# ADMIN_BASE_PATH=

# --- TTS (Text-to-Speech) ---
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_TRIGGER=$audio              # Tag users include in messages to request audio response

# --- Memories (Background Processor) ---
# BACKGROUND_AI_MODEL=gemini-3-flash-preview  # Cheap model for silent memory building
# BACKGROUND_DEBOUNCE_MS=300000               # 5 min inactivity triggers processing
# BACKGROUND_MESSAGE_THRESHOLD=20             # OR this many messages triggers processing
# MEMORIES_DIRECTORY=data/group_memories

# --- Active Listening ---
# ACTIVE_LISTENING_AI_MODEL=gemini-3-flash-preview  # Fast model for deciding when to respond
# ACTIVE_LISTENING_THROTTLE_MS=10000                # Min 10s between proactive responses
# ACTIVE_LISTENING_CONTEXT_COUNT=15                 # Recent messages sent to decision LLM

# --- WhatsApp Session (Baileys) ---
# AUTH_SESSION_PATH=./auth_session

# --- Directories (defaults are usually fine) ---
# DATA_DIRECTORY=data
# IMAGE_DIRECTORY=data/images
# AUDIO_DIRECTORY=data/audio

# --- Community Personas ---
# COMMUNITY_PERSONAS_REPO=najibelmokhtari/wispbot-personas   # GitHub owner/repo
# COMMUNITY_PERSONAS_TOKEN=                                   # Optional: for private repos
