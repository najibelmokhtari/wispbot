<%- include('layout') %>

<h2>Chats</h2>

<h3 class="section-heading">Groups</h3>

<% if (groups.length === 0 && unconfiguredGroups.length === 0) { %>
    <p>No groups found. Groups appear here once the bot receives messages in them.</p>
<% } else { %>
<figure>
<table>
    <thead>
        <tr>
            <th>Group Name</th>
            <th>Persona</th>
            <th>Model</th>
            <th class="toggle-cell">Search</th>
            <th class="toggle-cell">Audio</th>
            <th class="toggle-cell">TTS</th>
            <th class="toggle-cell">Auth Check</th>
            <th class="toggle-cell">BG</th>
            <th class="toggle-cell">Actions</th>
        </tr>
    </thead>
    <tbody>
        <% for (const g of groups) { %>
        <tr class="group-row" data-href="<%= basePath %>/groups/<%= encodeURIComponent(g.group_id) %>">
            <td>
                <strong><%= g.group_name || g.group_id %></strong><br>
                <small style="color:#999"><%= g.group_id %></small>
            </td>
            <td><%= g.default_prompt_name || 'default' %></td>
            <td><small><%= g.ai_model || 'gemini-2.5-pro' %></small></td>
            <td class="toggle-cell"><span class="<%= g.google_search_enabled ? 'badge-on' : 'badge-off' %>"><%= g.google_search_enabled ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell"><span class="<%= g.audio_enabled ? 'badge-on' : 'badge-off' %>"><%= g.audio_enabled ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell"><span class="<%= g.tts_enabled ? 'badge-on' : 'badge-off' %>"><%= g.tts_enabled ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell"><span class="<%= g.authorization_check_enabled ? 'badge-on' : 'badge-off' %>"><%= g.authorization_check_enabled ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell"><span class="<%= g.background_processing_enabled !== 0 ? 'badge-on' : 'badge-off' %>"><%= g.background_processing_enabled !== 0 ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell actions-cell">
                <% if (g.group_id.endsWith('@g.us')) { %>
                <button class="outline action-btn" data-action="inspect" data-group-id="<%= g.group_id %>" title="Inspect">👁</button>
                <% } %>
                <button class="outline secondary action-btn" data-action="deactivate" data-group-id="<%= g.group_id %>" title="Deactivate">⏸</button>
            </td>
        </tr>
        <% if (g.group_id.endsWith('@g.us')) { %>
        <tr class="inspect-row" id="inspect-row-<%= g.group_id %>" style="display:none">
            <td colspan="9" class="inspect-panel">
                <p aria-busy="true">Loading WhatsApp info…</p>
            </td>
        </tr>
        <% } %>
        <% } %>
        <% for (const g of unconfiguredGroups) { %>
        <tr class="group-row inactive">
            <td>
                <strong><%= g.group_name !== g.group_id ? g.group_name : 'Unknown Group' %></strong><br>
                <small style="color:#999"><%= g.group_id %></small>
            </td>
            <td colspan="7" style="color:#999">Not activated</td>
            <td class="toggle-cell actions-cell">
                <button class="outline action-btn" data-action="inspect" data-group-id="<%= g.group_id %>" title="Inspect">👁</button>
                <button class="action-btn" data-action="activate" data-group-id="<%= g.group_id %>" title="Activate">Activate</button>
            </td>
        </tr>
        <tr class="inspect-row" id="inspect-row-<%= g.group_id %>" style="display:none">
            <td colspan="9" class="inspect-panel">
                <p aria-busy="true">Loading WhatsApp info…</p>
            </td>
        </tr>
        <% } %>
    </tbody>
</table>
</figure>
<% } %>

<h3 class="section-heading">Direct Messages</h3>

<% if (dms.length === 0 && unconfiguredDms.length === 0) { %>
    <p>No direct messages found. DMs appear here once the bot receives direct messages.</p>
<% } else { %>
<figure>
<table>
    <thead>
        <tr>
            <th>Contact</th>
            <th>Persona</th>
            <th>Model</th>
            <th class="toggle-cell">Search</th>
            <th class="toggle-cell">Audio</th>
            <th class="toggle-cell">TTS</th>
            <th class="toggle-cell">Auth Check</th>
            <th class="toggle-cell">BG</th>
            <th class="toggle-cell">Actions</th>
        </tr>
    </thead>
    <tbody>
        <% for (const d of dms) { %>
        <tr class="group-row" data-href="<%= basePath %>/groups/<%= encodeURIComponent(d.group_id) %>">
            <td>
                <strong><%= d.resolved_name || d.group_name || d.group_id %></strong><br>
                <small style="color:#999"><%= d.group_id %></small>
            </td>
            <td><%= d.default_prompt_name || 'default' %></td>
            <td><small><%= d.ai_model || 'gemini-2.5-pro' %></small></td>
            <td class="toggle-cell"><span class="<%= d.google_search_enabled ? 'badge-on' : 'badge-off' %>"><%= d.google_search_enabled ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell"><span class="<%= d.audio_enabled ? 'badge-on' : 'badge-off' %>"><%= d.audio_enabled ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell"><span class="<%= d.tts_enabled ? 'badge-on' : 'badge-off' %>"><%= d.tts_enabled ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell"><span class="<%= d.authorization_check_enabled ? 'badge-on' : 'badge-off' %>"><%= d.authorization_check_enabled ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell"><span class="<%= d.background_processing_enabled !== 0 ? 'badge-on' : 'badge-off' %>"><%= d.background_processing_enabled !== 0 ? 'ON' : 'OFF' %></span></td>
            <td class="toggle-cell actions-cell">
                <button class="outline secondary action-btn" data-action="deactivate" data-group-id="<%= d.group_id %>" title="Deactivate">⏸</button>
            </td>
        </tr>
        <% } %>
        <% for (const d of unconfiguredDms) { %>
        <tr class="group-row inactive">
            <td>
                <strong><%= d.resolved_name || d.group_name || d.group_id %></strong><br>
                <small style="color:#999"><%= d.group_id %></small>
            </td>
            <td colspan="7" style="color:#999">Not activated</td>
            <td class="toggle-cell actions-cell">
                <button class="action-btn" data-action="activate" data-group-id="<%= d.group_id %>" title="Activate">Activate</button>
            </td>
        </tr>
        <% } %>
    </tbody>
</table>
</figure>
<% } %>

<%- include('footer') %>
