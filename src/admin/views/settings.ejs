<%- include('layout') %>

    <h2>Settings</h2>

    <!-- Bot Active Switch -->
    <article style="border: 2px solid <%= (settings.bot_active || '1') === '1' ? '#2e7d32' : '#c62828' %>;">
        <header style="background: <%= (settings.bot_active || '1') === '1' ? '#2e7d32' : '#c62828' %>;">
            <strong>Bot Status</strong>
        </header>
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem">
            <div>
                <label style="margin-bottom:0">
                    <input type="checkbox" role="switch" id="bot-active-switch"
                        <%= (settings.bot_active || '1') === '1' ? 'checked' : '' %>
                        onchange="toggleBotActive(this.checked)">
                    Bot is <strong id="bot-active-label"><%= (settings.bot_active || '1') === '1' ? 'ON' : 'OFF' %></strong>
                </label>
                <small class="field-desc" id="bot-active-desc" style="margin-top:0.5rem; <%= (settings.bot_active || '1') === '1' ? 'display:none;' : '' %>">
                    The bot will not respond to any messages. Commands (!usage, etc.) still work. Messages are still stored.
                </small>
            </div>
            <span id="bot-active-badge" style="font-size:0.85rem; padding:0.3rem 0.75rem; border-radius:6px; font-weight:600; background:<%= (settings.bot_active || '1') === '1' ? '#e8f5e9' : '#ffebee' %>; color:<%= (settings.bot_active || '1') === '1' ? '#2e7d32' : '#c62828' %>;">
                <%= (settings.bot_active || '1') === '1' ? 'Active' : 'Disabled' %>
            </span>
        </div>
    </article>

    <!-- Bot Identity -->
    <article>
        <header><strong>Bot Identity</strong></header>
        <% if (settings.bot_number) { %>
            <p style="margin-bottom:0"><strong>WhatsApp Number:</strong> +<%= settings.bot_number %>
            </p>
            <small style="display:block; color:#999; margin-top:-0.25rem">
                <%= settings.bot_user_id || '' %>
            </small>
            <% } else { %>
                <p style="color:#e65100; margin-bottom:0">Not connected yet. <a href="<%= basePath %>/connection">Go to
                        Connection
                        page</a> to scan the QR code.</p>
                <% } %>

                    <label for="bot-name-input" style="margin-top:1.5rem">Bot Display Name</label>
                    <small class="field-desc">The bot's name in conversation logs, mentions, and WhatsApp profile. Max
                        25 characters.</small>
                    <div class="inline-form">
                        <input type="text" id="bot-name-input" value="<%= settings.bot_name || '' %>"
                            placeholder="e.g. Wisp" maxlength="25">
                        <button onclick="saveBotName()">Save</button>
                    </div>

    </article>

    <!-- Message Handling -->
    <article>
        <header><strong>Message Handling</strong></header>

        <label for="bot-activation-mode">Default Activation Mode</label>
        <small class="field-desc">The default activation mode for new groups. Each group can override this in its own settings.</small>
        <select id="bot-activation-mode" onchange="updateDefaultDropdown('bot_activation_mode', this.value); toggleActivationMode();">
            <option value="manual" <%=(settings.bot_activation_mode || 'manual')==='manual' ? 'selected' : '' %>>Manual (Mention / Reply-to)</option>
            <option value="active_listening" <%=(settings.bot_activation_mode)==='active_listening' ? 'selected' : '' %>>Active Listening</option>
        </select>
        <small class="field-desc" id="activation-mode-desc-manual" style="<%= (settings.bot_activation_mode === 'active_listening') ? 'display:none;' : '' %>">
            New groups will default to manual mode — the bot only responds when mentioned or replied to.
        </small>
        <small class="field-desc" id="activation-mode-desc-al" style="<%= (settings.bot_activation_mode !== 'active_listening') ? 'display:none;' : '' %>">
            New groups will default to active listening — a fast LLM evaluates each message and decides whether the bot should proactively respond, without needing to be tagged or replied to.
            <br><strong>Note:</strong> Keep an eye on API usage if the bot is active in many busy groups, as each message triggers a lightweight AI evaluation.
        </small>

        <!-- Active Listening default settings -->
        <div id="active-listening-settings">

            <div class="settings-grid" style="margin-top:1rem">
                <div>
                    <label for="active-listening-ai-model">Active Listening AI Model</label>
                    <select id="active-listening-ai-model"
                        onchange="updateDefaultDropdown('active_listening_ai_model', this.value)">
                        <% for (const [key, info] of Object.entries(models)) { %>
                            <option value="<%= key %>" <%=(settings.active_listening_ai_model || 'gemini-3-flash-preview'
                                )===key ? 'selected' : '' %>><%= info.displayName %>
                            </option>
                            <% } %>
                    </select>
                </div>
            </div>

            <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Throttle Settings</h5>
            <small class="section-desc">Controls how often the bot can proactively respond. Per-group overrides can be set
                on each group's page.</small>
            <div class="settings-grid">
                <div>
                    <label for="default-al-throttle">Throttle Time (seconds)</label>
                    <small class="field-desc">Minimum time between proactive responses in a group.</small>
                    <div class="inline-form">
                        <input type="number" id="default-al-throttle" min="1" step="1"
                            value="<%= settings.default_active_listening_throttle_ms ? Math.round(settings.default_active_listening_throttle_ms / 1000) : '5' %>">
                        <button onclick="saveDefaultActiveListeningThrottle()">Save</button>
                    </div>
                </div>
                <div>
                    <label for="default-al-context-count">Context Messages</label>
                    <small class="field-desc">Number of recent messages sent to the fast LLM for decision-making.</small>
                    <div class="inline-form">
                        <input type="number" id="default-al-context-count" min="1" max="50" step="1"
                            value="<%= settings.default_active_listening_context_count || '15' %>">
                        <button onclick="saveDefaultActiveListeningContextCount()">Save</button>
                    </div>
                </div>
            </div>

            <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Media Attachments</h5>
            <small class="section-desc">Default settings for sending audio/images to the active listener LLM. Per-group overrides can be set on each group's page.</small>
            <div class="settings-grid">
                <fieldset>
                    <label>
                        <input type="checkbox" role="switch" id="default-al-send-audio"
                            <%= settings.default_al_send_audio === '1' ? 'checked' : '' %>
                            onchange="updateDefaultToggle('default_al_send_audio', this.checked)">
                        Send Audio by Default
                        <span class="info-icon">i<span class="info-tooltip">When enabled, recent audio files will be attached to active listener LLM calls by default for new groups.</span></span>
                    </label>
                </fieldset>
                <fieldset>
                    <label>
                        <input type="checkbox" role="switch" id="default-al-send-images"
                            <%= settings.default_al_send_images === '1' ? 'checked' : '' %>
                            onchange="updateDefaultToggle('default_al_send_images', this.checked)">
                        Send Images by Default
                        <span class="info-icon">i<span class="info-tooltip">When enabled, recent images will be attached to active listener LLM calls by default for new groups.</span></span>
                    </label>
                </fieldset>
            </div>
            <div class="settings-grid" style="margin-top:0.5rem">
                <div>
                    <label for="default-al-audio-count">Audio Count</label>
                    <small class="field-desc">Number of recent audio messages to attach to the active listener.</small>
                    <div class="inline-form">
                        <input type="number" id="default-al-audio-count" min="1" max="10" step="1"
                            value="<%= settings.default_al_audio_count || '3' %>">
                        <button onclick="saveDefaultAlAudioCount()">Save</button>
                    </div>
                </div>
                <div>
                    <label for="default-al-image-count">Image Count</label>
                    <small class="field-desc">Number of recent images to attach to the active listener.</small>
                    <div class="inline-form">
                        <input type="number" id="default-al-image-count" min="1" max="10" step="1"
                            value="<%= settings.default_al_image_count || '3' %>">
                        <button onclick="saveDefaultAlImageCount()">Save</button>
                    </div>
                </div>
            </div>

            <% const alSp=systemPrompts.find(sp=> sp.name === 'active_listening_instruction'); %>
                <% if (alSp) { %>
                    <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Decision Prompt</h5>
                    <small class="section-desc">
                        <%= alSp.description %>
                    </small>
                    <details id="sysprompt-detail-<%= alSp.name %>" style="margin-top:0.5rem">
                        <summary onclick="loadSystemPrompt('<%= alSp.name %>')">
                            <%= alSp.displayName %>
                        </summary>
                        <textarea id="sysprompt-content-<%= alSp.name %>" class="persona-editor" placeholder="Loading..."
                            data-save-btn="btn-save-sysprompt-<%= alSp.name %>"></textarea>
                        <button id="btn-save-sysprompt-<%= alSp.name %>" onclick="saveSystemPrompt('<%= alSp.name %>')"
                            disabled>Save</button>
                    </details>
                    <% } %>
        </div>

        <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Offline Messages</h5>
        <small class="section-desc">Controls what happens to messages received while the bot was offline. Messages are
            always stored in the database regardless of this setting.</small>

        <label for="offline-message-mode">Mode</label>
        <select id="offline-message-mode" onchange="updateDefaultDropdown('offline_message_mode', this.value)">
            <option value="store_only" <%=(settings.offline_message_mode)==='store_only' ? 'selected'
                : '' %>>Store Only (no AI responses)</option>
            <option value="last_trigger" <%=(settings.offline_message_mode || 'last_trigger')==='last_trigger' ? 'selected' : '' %>>Respond to Last Trigger</option>
        </select>
        <small class="field-desc">
            <strong>Store Only</strong> — Messages are saved to conversation history but do not trigger the AI. This is
            the safest option to avoid flooding the bot with stale responses on reconnect.<br>
            <strong>Last Trigger</strong> — Processes only the last triggering message per group. In manual mode
            (active listening off), responds to the last mention or reply-to-bot. In active listening mode, feeds the
            last message to the active listener to decide whether to respond.
        </small>

        <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Error Reporting</h5>
        <small class="section-desc">Controls how LLM errors (e.g. API failures) are reported. Errors are always logged to the server console regardless of this setting.</small>

        <label for="error-reporting-mode">Mode</label>
        <select id="error-reporting-mode" onchange="updateDefaultDropdown('error_reporting_mode', this.value)">
            <option value="send_to_chat" <%=(settings.error_reporting_mode || 'send_to_chat')==='send_to_chat' ? 'selected' : '' %>>Send to Chat</option>
            <option value="log_only" <%=(settings.error_reporting_mode)==='log_only' ? 'selected' : '' %>>Log Only</option>
        </select>
        <small class="field-desc">
            <strong>Send to Chat</strong> — Sends an error message to the group where the error occurred (e.g. "Sorry, I encountered an error...").<br>
            <strong>Log Only</strong> — Errors are only logged to the server console. No error message is sent to the group.
        </small>
    </article>

    <!-- Defaults for New Groups -->
    <article>
        <header><strong>Defaults for New Groups</strong></header>
        <small class="section-desc">These settings are applied when a new group or DM is activated.</small>

        <div class="settings-grid">
            <fieldset>
                <label>
                    <input type="checkbox" role="switch" id="default-google_search" <%=(settings.default_google_search
                        || '1' )==='1' ? 'checked' : '' %>
                    onchange="updateDefaultToggle('default_google_search', this.checked)">
                    Google Search
                    <span class="info-icon">i<span class="info-tooltip">Allows the AI to search Google for up-to-date
                            information when answering questions. The AI decides automatically when a search would be
                            helpful.</span></span>
                </label>
                <label>
                    <input type="checkbox" role="switch" id="default-audio" <%=(settings.default_audio || '1' )==='1'
                        ? 'checked' : '' %>
                    onchange="updateDefaultToggle('default_audio', this.checked)">
                    Audio Processing
                    <span class="info-icon">i<span class="info-tooltip">When enabled, the bot includes the audio memos
                            in the AI's context. When
                            disabled, audio messages are ignored.</span></span>
                </label>
                <label>
                    <input type="checkbox" role="switch" id="default-image" <%=(settings.default_image || '1' )==='1'
                        ? 'checked' : '' %>
                    onchange="updateDefaultToggle('default_image', this.checked)">
                    Image Processing
                    <span class="info-icon">i<span class="info-tooltip">When enabled, the bot includes images
                            in the AI's context. When disabled, images are ignored.</span></span>
                </label>
                <label>
                    <input type="checkbox" role="switch" id="default-tts" <%=(settings.default_tts || '1' )==='1'
                        ? 'checked' : '' %>
                    onchange="updateDefaultToggle('default_tts', this.checked)">
                    Text-to-Speech
                    <span class="info-icon">i<span class="info-tooltip">Allows users to receive the bot's response as a
                            voice message. Triggered when a user includes the Text-To-Speech trigger tag (configured
                            above) in their message, or when AI Active Listening decides to use it.</span></span>
                </label>
                <label>
                    <input type="checkbox" role="switch" id="default-auth_check" <%=settings.default_auth_check==='1'
                        ? 'checked' : '' %>
                    onchange="updateDefaultToggle('default_auth_check', this.checked)">
                    Authorization Check
                    <span class="info-icon">i<span class="info-tooltip">When enabled, only authorized users and admins
                            can invoke the bot in this chat. Unauthorized users are silently ignored. Manage authorized
                            users from the Users page.</span></span>
                </label>
            </fieldset>
            <fieldset>
                <label for="default-model">Default AI Model</label>
                <select id="default-model" onchange="updateDefaultDropdown('default_ai_model', this.value)">
                    <% for (const [key, info] of Object.entries(models)) { %>
                        <option value="<%= key %>" <%=(settings.default_ai_model || 'gemini-4-argon' )===key
                            ? 'selected' : '' %>><%= info.displayName %>
                        </option>
                        <% } %>
                </select>
                <label for="default-persona">Default Persona</label>
                <div style="display:flex; gap:0.5rem; align-items:center;">
                    <select id="default-persona" onchange="updateDefaultDropdown('default_persona', this.value)"
                        style="margin-bottom:0">
                        <% for (const p of personas) { %>
                            <option value="<%= p %>" <%=(settings.default_persona || 'default' )===p ? 'selected' : ''
                                %>>
                                <%= p %>
                            </option>
                            <% } %>
                    </select>
                    <a id="edit-default-persona-link"
                        href="<%= basePath %>/personas#persona-<%= settings.default_persona || 'default' %>"
                        class="outline secondary" role="button"
                        style="white-space:nowrap; padding:0.5rem 0.75rem; font-size:0.85rem;<%= (settings.default_persona || 'default') === 'default' ? ' display:none;' : '' %>">Edit
                        Persona ></a>
                </div>
                <label for="default-history-limit">Message History Limit</label>
                <small class="field-desc">Number of recent messages sent to the AI for context. Per-group overrides can
                    be set on each group's page.</small>
                <div class="inline-form">
                    <input type="number" id="default-history-limit" min="1" max="500" step="1"
                        value="<%= settings.default_message_history_limit || '20' %>" placeholder="20">
                    <button onclick="saveDefaultHistoryLimit()">Save</button>
                </div>
            </fieldset>
        </div>

        <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Audio Processing Defaults</h5>
        <small class="section-desc">Configure how audio messages are processed by default for new groups.</small>
        <div class="settings-grid" style="margin-top:0.5rem">
            <fieldset>
                <label for="default-audio-history-mode">Audio History Mode</label>
                <small class="field-desc">How audio messages are included in AI calls.</small>
                <select id="default-audio-history-mode"
                    onchange="updateDefaultDropdown('default_audio_history_mode', this.value); toggleDefaultAudioHistoryCount();">
                    <option value="tagged" <%=(settings.default_audio_history_mode || 'tagged' )==='tagged' ? 'selected'
                        : '' %>>Tagged/Replied Only</option>
                    <option value="history" <%=(settings.default_audio_history_mode || 'tagged' )==='history'
                        ? 'selected' : '' %>>Last X in History</option>
                </select>
                <div id="default-audio-history-count-container"
                    style="<%= (settings.default_audio_history_mode || 'tagged') === 'tagged' ? 'display:none;' : '' %>">
                    <label for="default-audio-history-count">Audio History Count</label>
                    <small class="field-desc">Number of recent audio messages to include in AI context.</small>
                    <div class="inline-form">
                        <input type="number" id="default-audio-history-count" min="1" max="20" step="1"
                            value="<%= settings.default_audio_history_count || '1' %>" placeholder="1">
                        <button onclick="saveDefaultAudioHistoryCount()">Save</button>
                    </div>
                </div>
            </fieldset>
            <div>
                <label for="default-audio-duration-cap">Audio Duration Cap (seconds)</label>
                <small class="field-desc">Max audio duration the bot will process. Set to 0 for no limit.</small>
                <div class="inline-form">
                    <input type="number" id="default-audio-duration-cap" min="0" step="1"
                        value="<%= settings.default_audio_duration_cap || '900' %>" placeholder="900">
                    <button onclick="saveDefaultAudioDurationCap()">Save</button>
                </div>
            </div>
        </div>

        <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Image Processing Defaults</h5>
        <small class="section-desc">Configure how images are processed by default for new groups.</small>
        <div class="settings-grid" style="margin-top:0.5rem">
            <fieldset>
                <label for="default-image-history-mode">Image History Mode</label>
                <small class="field-desc">How images are included in AI calls.</small>
                <select id="default-image-history-mode"
                    onchange="updateDefaultDropdown('default_image_history_mode', this.value); toggleDefaultImageHistoryCount();">
                    <option value="tagged" <%=(settings.default_image_history_mode || 'tagged' )==='tagged' ? 'selected'
                        : '' %>>Tagged/Replied Only</option>
                    <option value="history" <%=(settings.default_image_history_mode || 'tagged' )==='history'
                        ? 'selected' : '' %>>Last X in History</option>
                </select>
                <div id="default-image-history-count-container"
                    style="<%= (settings.default_image_history_mode || 'tagged') === 'tagged' ? 'display:none;' : '' %>">
                    <label for="default-image-history-count">Image History Count</label>
                    <small class="field-desc">Number of recent images to include in AI context.</small>
                    <div class="inline-form">
                        <input type="number" id="default-image-history-count" min="1" max="20" step="1"
                            value="<%= settings.default_image_history_count || '1' %>" placeholder="1">
                        <button onclick="saveDefaultImageHistoryCount()">Save</button>
                    </div>
                </div>
            </fieldset>
        </div>

        <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Text-to-Speech Defaults</h5>
        <small class="section-desc">Voice and style are configured per persona below. This section controls trigger
            behavior for new groups.</small>
        <div style="margin-top:0.5rem">
            <label for="default-tts-trigger-mode">Default TTS Trigger Mode</label>
            <small class="field-desc">How TTS is triggered by default for new groups. "By Tag" means the user must
                include <code id="tts-trigger-preview"><%= settings.tts_trigger || '$audio' %></code> in their message.
                "Let AI decide" lets the AI choose between text and a voice note, guided by each persona's and group's
                voice reply instructions (the tag still forces a voice note).</small>
            <select id="default-tts-trigger-mode"
                onchange="updateDefaultDropdown('default_tts_trigger_mode', this.value); toggleTtsTriggerTag();">
                <option value="tag" <%=(settings.default_tts_trigger_mode || 'tag' )==='tag' ? 'selected' : '' %>>By Tag
                </option>
                <option value="always" <%=(settings.default_tts_trigger_mode || 'tag' )==='always' ? 'selected' : '' %>
                    >Always</option>
                <option value="auto" <%=(settings.default_tts_trigger_mode || 'tag' )==='auto' ? 'selected' : '' %>
                    >Let AI decide</option>
            </select>
            <div id="tts-trigger-tag-container"
                style="margin-top:0.75rem;<%= (settings.default_tts_trigger_mode || 'tag') === 'always' ? ' display:none;' : '' %>">
                <label for="tts-trigger-input">Trigger Tag</label>
                <small class="field-desc">The tag users include in their message to request an audio response.</small>
                <div class="inline-form">
                    <input type="text" id="tts-trigger-input" value="<%= settings.tts_trigger || '$audio' %>"
                        placeholder="e.g. $audio"
                        oninput="document.getElementById('tts-trigger-preview').textContent = this.value || '$audio'">
                    <button onclick="saveTtsTrigger()">Save</button>
                </div>
            </div>
        </div>

    </article>

    <!-- System Prompts -->
    <article>
        <header><strong>System Prompts</strong></header>
        <small class="section-desc">These prompt blocks are used by the bot when composing messages to the AI. Changes
            take effect immediately.</small>

        <div id="system-prompt-list">
            <% for (const sp of systemPrompts) { %>
                <% if (sp.name==='background_memories_instruction' || sp.name==='active_listening_instruction' )
                    continue; %>
                    <details id="sysprompt-detail-<%= sp.name %>">
                        <summary onclick="loadSystemPrompt('<%= sp.name %>')">
                            <%= sp.displayName %>
                                <br><small style="color:#666">
                                    <%= sp.description %>
                                </small>
                        </summary>
                        <textarea id="sysprompt-content-<%= sp.name %>" class="persona-editor" placeholder="Loading..."
                            data-save-btn="btn-save-sysprompt-<%= sp.name %>"></textarea>
                        <button id="btn-save-sysprompt-<%= sp.name %>" onclick="saveSystemPrompt('<%= sp.name %>')"
                            disabled>Save</button>
                    </details>
                    <% } %>
        </div>
    </article>


    <!-- Memories -->
    <article>
        <header><strong>Memories</strong></header>
        <small class="section-desc">Silently observes group messages and builds conversation memories using a separate
            AI call. Memories are injected into the AI's context for richer responses.
            <br><strong>Note:</strong> Keep an eye on API usage if enabled in many busy groups, as each batch triggers a separate AI call.</small>

        <label>
            <input type="checkbox" role="switch" id="background-global-enabled"
                <%=(settings.background_processing_global || '0' )==='1' ? 'checked' : '' %>
            onchange="updateDefaultToggle('background_processing_global', this.checked)">
            Enable Memories
            <span class="info-icon">i<span class="info-tooltip">Master switch for memories. When disabled,
                    no memory building will run for any group, regardless of per-group settings.</span></span>
        </label>

        <div class="settings-grid" style="margin-top:1rem">
            <fieldset>
                <label>
                    <input type="checkbox" role="switch" id="default-background_processing"
                        <%=settings.default_background_processing==='1' ? 'checked' : '' %>
                    onchange="updateDefaultToggle('default_background_processing', this.checked)">
                    Enable Active Listening by Default for New Groups
                    <span class="info-icon">i<span class="info-tooltip">When enabled, memory building will be
                            turned on automatically for newly activated groups.</span></span>
                </label>
            </fieldset>
            <div>
                <label for="background-ai-model">Memories AI Model</label>
                <select id="background-ai-model" onchange="updateDefaultDropdown('background_ai_model', this.value)">
                    <% for (const [key, info] of Object.entries(models)) { %>
                        <option value="<%= key %>" <%=(settings.background_ai_model || 'gemini-3-flash-preview' )===key
                            ? 'selected' : '' %>><%= info.displayName %>
                        </option>
                        <% } %>
                </select>
            </div>
        </div>

        <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Debounce Settings</h5>
        <small class="section-desc">Controls when memory building triggers. Per-group overrides can be set on each
            group's page.</small>
        <div class="settings-grid">
            <div>
                <label for="default-bg-debounce">Debounce Time (seconds)</label>
                <div class="inline-form">
                    <input type="number" id="default-bg-debounce" min="10" step="1"
                        value="<%= settings.default_background_debounce_ms ? Math.round(settings.default_background_debounce_ms / 1000) : '300' %>">
                    <button onclick="saveDefaultDebounce()">Save</button>
                </div>
            </div>
            <div>
                <label for="default-bg-threshold">Message Threshold</label>
                <div class="inline-form">
                    <input type="number" id="default-bg-threshold" min="1" step="1"
                        value="<%= settings.default_background_message_threshold || '20' %>">
                    <button onclick="saveDefaultThreshold()">Save</button>
                </div>
            </div>
        </div>

        <% const bgMemSp=systemPrompts.find(sp=> sp.name === 'background_memories_instruction'); %>
            <% if (bgMemSp) { %>
                <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Memory Extraction Prompt</h5>
                <small class="section-desc">
                    <%= bgMemSp.description %>
                </small>
                <details id="sysprompt-detail-<%= bgMemSp.name %>" style="margin-top:0.5rem">
                    <summary onclick="loadSystemPrompt('<%= bgMemSp.name %>')">
                        <%= bgMemSp.displayName %>
                    </summary>
                    <textarea id="sysprompt-content-<%= bgMemSp.name %>" class="persona-editor" placeholder="Loading..."
                        data-save-btn="btn-save-sysprompt-<%= bgMemSp.name %>"></textarea>
                    <button id="btn-save-sysprompt-<%= bgMemSp.name %>"
                        onclick="saveSystemPrompt('<%= bgMemSp.name %>')" disabled>Save</button>
                </details>
                <% } %>
    </article>


    <%- include('footer') %>