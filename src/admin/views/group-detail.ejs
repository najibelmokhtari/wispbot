<%- include('layout') %>

<p><a href="<%= basePath %>/groups">&larr; Back to Groups</a></p>

<h2><%= group.group_name || group.group_id %></h2>
<p style="color:#999"><small><%= group.group_id %></small></p>

<!-- Settings -->
<article>
    <header><strong>Settings</strong></header>
    <div class="settings-grid">
        <fieldset>
            <label>
                <input type="checkbox" role="switch" id="toggle-google_search_enabled"
                    data-group="<%= group.group_id %>" data-field="google_search_enabled"
                    <%= group.google_search_enabled ? 'checked' : '' %>
                    onchange="toggleSetting(this)">
                Google Search
                <span class="info-icon">i<span class="info-tooltip">Allows the AI to search Google for up-to-date information when answering questions. The AI decides automatically when a search would be helpful.</span></span>
            </label>
            <label>
                <input type="checkbox" role="switch" id="toggle-audio_enabled"
                    data-group="<%= group.group_id %>" data-field="audio_enabled"
                    <%= group.audio_enabled ? 'checked' : '' %>
                    onchange="toggleSetting(this)">
                Audio Processing
                <span class="info-icon">i<span class="info-tooltip">When enabled, the bot includes voice memos in the AI's context. When disabled, audio messages are ignored.</span></span>
            </label>
            <label>
                <input type="checkbox" role="switch" id="toggle-image_enabled"
                    data-group="<%= group.group_id %>" data-field="image_enabled"
                    <%= group.image_enabled ? 'checked' : '' %>
                    onchange="toggleSetting(this)">
                Image Processing
                <span class="info-icon">i<span class="info-tooltip">When enabled, the bot includes images in the AI's context. When disabled, images are ignored.</span></span>
            </label>
            <label>
                <input type="checkbox" role="switch" id="toggle-tts_enabled"
                    data-group="<%= group.group_id %>" data-field="tts_enabled"
                    <%= group.tts_enabled ? 'checked' : '' %>
                    onchange="toggleSetting(this)">
                Text-to-Speech
                <span class="info-icon">i<span class="info-tooltip">Allows users to receive the bot's response as a voice message. Triggered when a user includes the Text-To-Speech trigger tag in their message. Configure the trigger tag in Settings.</span></span>
            </label>
            <label>
                <input type="checkbox" role="switch" id="toggle-authorization_check_enabled"
                    data-group="<%= group.group_id %>" data-field="authorization_check_enabled"
                    <%= group.authorization_check_enabled ? 'checked' : '' %>
                    onchange="toggleSetting(this)">
                Authorization Check
                <span class="info-icon">i<span class="info-tooltip">When enabled, only authorized users and admins can invoke the bot in this chat. Unauthorized users are silently ignored. Manage authorized users from the Users page.</span></span>
            </label>
            <label>
                <input type="checkbox" role="switch" id="toggle-active_listening_enabled"
                    data-group="<%= group.group_id %>" data-field="active_listening_enabled"
                    <%= group.active_listening_enabled !== 0 ? 'checked' : '' %>
                    onchange="toggleSetting(this)"
                >
                Active Listening
                <span class="info-icon">i<span class="info-tooltip">When enabled, a fast LLM evaluates each message and decides whether the bot should respond — without being tagged.</span></span>
            </label>
        </fieldset>
        <fieldset>
            <label for="select-model">AI Model</label>
            <select id="select-model" data-group="<%= group.group_id %>" onchange="updateDropdown(this, 'ai_model')">
                <% for (const [key, info] of Object.entries(models)) { %>
                <option value="<%= key %>" <%= (group.ai_model || 'gemini-4-argon') === key ? 'selected' : '' %>><%= info.displayName %></option>
                <% } %>
            </select>
            <label for="select-persona">Persona</label>
            <div style="display:flex; gap:0.5rem; align-items:center;">
                <select id="select-persona" data-group="<%= group.group_id %>" onchange="updateDropdown(this, 'default_prompt_name')" style="margin-bottom:0">
                    <% for (const p of personas) { %>
                    <option value="<%= p %>" <%= (group.default_prompt_name || 'default') === p ? 'selected' : '' %>><%= p %></option>
                    <% } %>
                </select>
                <a id="edit-persona-link" href="<%= basePath %>/personas#persona-<%= group.default_prompt_name || 'default' %>" class="outline secondary" role="button" style="white-space:nowrap; padding:0.5rem 0.75rem; font-size:0.85rem;<%= (group.default_prompt_name || 'default') === 'default' ? ' display:none;' : '' %>">Edit Persona ></a>
            </div>
        </fieldset>
    </div>

    <div id="audio-settings-section" style="<%= group.audio_enabled ? '' : 'display:none;' %>">
        <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Audio Settings</h5>
        <small class="section-desc">Configure how audio messages are processed and included in the AI's context.</small>
        <div class="settings-grid" style="margin-top:0.5rem">
            <div>
                <label for="select-audio-mode">Audio History Mode</label>
                <small class="field-desc">How audio messages are included in AI calls.</small>
                <select id="select-audio-mode" data-group="<%= group.group_id %>" onchange="updateDropdown(this, 'audio_history_mode'); toggleAudioHistoryCount();">
                    <option value="tagged" <%= (group.audio_history_mode || 'tagged') === 'tagged' ? 'selected' : '' %>>Tagged/Replied Only</option>
                    <option value="history" <%= (group.audio_history_mode || 'tagged') === 'history' ? 'selected' : '' %>>Last X in History</option>
                </select>
            </div>
            <div id="audio-history-count-container" style="<%= (group.audio_history_mode || 'tagged') === 'tagged' ? 'display:none;' : '' %>">
                <label for="audio-history-count-input">Audio History Count</label>
                <small class="field-desc">Number of recent audio messages to include. Leave empty for default (<%= defaultAudioHistoryCount %>).</small>
                <div class="inline-form">
                    <input type="number" id="audio-history-count-input" min="1" max="20" step="1"
                        value="<%= group.audio_history_count != null && group.audio_history_count !== 1 ? group.audio_history_count : '' %>"
                        placeholder="<%= defaultAudioHistoryCount %>">
                    <button onclick="saveAudioHistoryCount('<%= group.group_id %>')">Save</button>
                </div>
            </div>
        </div>
        <div style="margin-top:0.75rem">
            <label for="audio-duration-cap-input">Audio Duration Cap (seconds)</label>
            <small class="field-desc">Max audio duration the bot will process. Leave empty for default (<%= defaultAudioDurationCap %>s). Set to 0 for no limit.</small>
            <div class="inline-form">
                <input type="number" id="audio-duration-cap-input" min="0" step="1"
                    value="<%= group.audio_duration_cap != null && group.audio_duration_cap !== 900 ? group.audio_duration_cap : '' %>"
                    placeholder="<%= defaultAudioDurationCap %>">
                <button onclick="saveAudioDurationCap('<%= group.group_id %>')">Save</button>
            </div>
        </div>
        <div class="settings-grid" style="margin-top:0.75rem">
            <div>
                <label for="select-audio-preview">Voice Note Previews</label>
                <small class="field-desc">Transcribe the opening seconds of every voice note in the background, so the AI sees what each one starts with in the chat history. It can always listen to a whole voice note on demand.</small>
                <select id="select-audio-preview" data-group="<%= group.group_id %>" onchange="updateDropdown(this, 'audio_preview_enabled'); toggleAudioPreviewSeconds();">
                    <option value="0" <%= group.audio_preview_enabled ? '' : 'selected' %>>Off</option>
                    <option value="1" <%= group.audio_preview_enabled ? 'selected' : '' %>>On</option>
                </select>
            </div>
            <div id="audio-preview-seconds-container" style="<%= group.audio_preview_enabled ? '' : 'display:none;' %>">
                <label for="audio-preview-seconds-input">Preview Length (seconds)</label>
                <small class="field-desc">How much of each voice note to transcribe. Leave empty for default (<%= defaultAudioPreviewSeconds %>s).</small>
                <div class="inline-form">
                    <input type="number" id="audio-preview-seconds-input" min="1" max="120" step="1"
                        value="<%= group.audio_preview_seconds || '' %>"
                        placeholder="<%= defaultAudioPreviewSeconds %>">
                    <button onclick="saveAudioPreviewSeconds('<%= group.group_id %>')">Save</button>
                </div>
            </div>
        </div>
    </div>

    <div id="image-settings-section" style="<%= group.image_enabled ? '' : 'display:none;' %>">
        <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Image Settings</h5>
        <small class="section-desc">Configure how images are processed and included in the AI's context.</small>
        <div class="settings-grid" style="margin-top:0.5rem">
            <div>
                <label for="select-image-mode">Image History Mode</label>
                <small class="field-desc">How images are included in AI calls.</small>
                <select id="select-image-mode" data-group="<%= group.group_id %>" onchange="updateDropdown(this, 'image_history_mode'); toggleImageHistoryCount();">
                    <option value="tagged" <%= (group.image_history_mode || 'tagged') === 'tagged' ? 'selected' : '' %>>Tagged/Replied Only</option>
                    <option value="history" <%= (group.image_history_mode || 'tagged') === 'history' ? 'selected' : '' %>>Last X in History</option>
                </select>
            </div>
            <div id="image-history-count-container" style="<%= (group.image_history_mode || 'tagged') === 'tagged' ? 'display:none;' : '' %>">
                <label for="image-history-count-input">Image History Count</label>
                <small class="field-desc">Number of recent images to include. Leave empty for default (<%= defaultImageHistoryCount %>).</small>
                <div class="inline-form">
                    <input type="number" id="image-history-count-input" min="1" max="20" step="1"
                        value="<%= group.image_history_count != null && group.image_history_count !== 1 ? group.image_history_count : '' %>"
                        placeholder="<%= defaultImageHistoryCount %>">
                    <button onclick="saveImageHistoryCount('<%= group.group_id %>')">Save</button>
                </div>
            </div>
        </div>
    </div>

    <div id="tts-settings-section" style="<%= group.tts_enabled ? '' : 'display:none;' %>">
        <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Text-to-Speech Settings</h5>
        <small class="section-desc">Voice and style are configured per persona in <a href="<%= basePath %>/personas#persona-<%= group.default_prompt_name || 'default' %>">Settings</a>.</small>
        <div style="margin-top:0.5rem">
            <label for="select-tts-trigger-mode">Trigger Mode</label>
            <small class="field-desc">How TTS is triggered for this group. "By Tag" means the user must include <code><%= ttsTrigger %></code> in their message. "Let AI decide" lets the AI choose between text and a voice note based on the conversation and the instructions below (<code><%= ttsTrigger %></code> still forces a voice note).</small>
            <select id="select-tts-trigger-mode" data-group="<%= group.group_id %>" onchange="updateDropdown(this, 'tts_trigger_mode'); toggleGroupTtsAutoSection(this.value);">
                <option value="tag" <%= (group.tts_trigger_mode || 'tag') === 'tag' ? 'selected' : '' %>>By Tag</option>
                <option value="always" <%= (group.tts_trigger_mode || 'tag') === 'always' ? 'selected' : '' %>>Always</option>
                <option value="auto" <%= (group.tts_trigger_mode || 'tag') === 'auto' ? 'selected' : '' %>>Let AI decide</option>
            </select>
        </div>
        <div id="tts-auto-instructions-section" style="margin-top:0.75rem;<%= (group.tts_trigger_mode || 'tag') === 'auto' ? '' : ' display:none;' %>">
            <label for="tts-auto-editor">Voice Reply Instructions</label>
            <small class="field-desc">When the AI should (or shouldn't) answer with a voice note in this group. Combined with the persona's voice reply instructions; these take precedence. Leave empty to rely on the persona and the AI's judgment.</small>
            <textarea id="tts-auto-editor" class="context-editor" data-group="<%= group.group_id %>" data-save-btn="btn-save-tts-auto" placeholder="e.g. Use voice notes for jokes and birthday wishes. Never use voice for homework answers."><%= group.tts_auto_instructions || '' %></textarea>
            <button id="btn-save-tts-auto" onclick="saveGroupTtsAutoInstructions('<%= group.group_id %>')" disabled>Save</button>
        </div>
    </div>

    <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Message History</h5>
    <small class="section-desc">Number of recent messages sent to the AI. Leave empty to use the global default (<%= defaultHistoryLimit %>).</small>
    <div class="inline-form">
        <input type="number" id="history-limit-input" min="1" max="500" step="1"
            value="<%= group.custom_message_limit || '' %>"
            placeholder="<%= defaultHistoryLimit %>">
        <button onclick="saveHistoryLimit('<%= group.group_id %>')">Save</button>
    </div>

    <label for="group-name-input" style="margin-top:1.5rem">Group Name</label>
    <div class="inline-form">
        <input type="text" id="group-name-input" value="<%= group.group_name || '' %>" placeholder="Group display name">
        <button onclick="saveGroupName('<%= group.group_id %>')">Save</button>
    </div>
</article>

<!-- Group Context -->
<article>
    <header><strong>Group Context</strong></header>
    <small class="section-desc">Custom context injected into every AI response for this group.</small>
    <textarea id="context-editor" class="context-editor" data-group="<%= group.group_id %>" data-save-btn="btn-save-context"><%= context %></textarea>
    <button id="btn-save-context" onclick="saveContext('<%= group.group_id %>')" disabled>Save Context</button>
</article>


<!-- Memories -->
<article>
    <header><strong>Memories</strong></header>

    <div class="<%= backgroundGlobalEnabled ? '' : 'section-disabled-wrapper' %>">
    <% if (!backgroundGlobalEnabled) { %>
        <div class="section-disabled-overlay">
            <span class="disabled-tooltip">Enable Memories from the global Settings page to use this feature</span>
        </div>
    <% } %>

    <label>
        <input type="checkbox" role="switch" id="toggle-background_processing_enabled"
            data-group="<%= group.group_id %>" data-field="background_processing_enabled"
            <%= group.background_processing_enabled !== 0 ? 'checked' : '' %>
            onchange="toggleSetting(this)">
        Enable Memories
        <span class="info-icon">i<span class="info-tooltip">Automatically processes group messages in the background to build and maintain conversation memories. Runs after a debounce period or message threshold is reached.</span></span>
    </label>

    <div class="settings-grid" style="margin-top:1rem">
        <div>
            <label for="bg-debounce-input">Debounce Time (seconds)</label>
            <small class="section-desc">Wait time before triggering. Leave empty to use the global default (<%= defaultDebounceSeconds %>).</small>
            <div class="inline-form">
                <input type="number" id="bg-debounce-input" min="10" step="1"
                    value="<%= group.background_debounce_ms ? Math.round(group.background_debounce_ms / 1000) : '' %>"
                    placeholder="<%= defaultDebounceSeconds %>">
                <button onclick="saveGroupDebounce('<%= group.group_id %>')">Save</button>
            </div>
        </div>
        <div>
            <label for="bg-threshold-input">Message Threshold</label>
            <small class="section-desc">Messages before triggering. Leave empty to use the global default (<%= defaultMessageThreshold %>).</small>
            <div class="inline-form">
                <input type="number" id="bg-threshold-input" min="1" step="1"
                    value="<%= group.background_message_threshold || '' %>"
                    placeholder="<%= defaultMessageThreshold %>">
                <button onclick="saveGroupThreshold('<%= group.group_id %>')">Save</button>
            </div>
        </div>
    </div>

    <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Stored Memories</h5>
    <small class="section-desc">Auto-maintained by the memories feature. These are injected into the AI's context. You can also edit manually.</small>
    <textarea id="memories-editor" class="context-editor" data-group="<%= group.group_id %>" data-save-btn="btn-save-memories"><%= memories %></textarea>
    <button id="btn-save-memories" onclick="saveMemories('<%= group.group_id %>')" disabled>Save Memories</button>
    </div>
</article>

<!-- Active Listening -->
<article id="active-listening-section">
    <header><strong>Active Listening</strong></header>

    <div class="<%= group.active_listening_enabled === 0 ? 'section-disabled-wrapper' : '' %>" id="active-listening-content">
    <% if (group.active_listening_enabled === 0) { %>
        <div class="section-disabled-overlay" id="al-disabled-overlay">
            <span class="disabled-tooltip">Enable Active Listening above to configure these settings</span>
        </div>
    <% } %>

    <div class="settings-grid" style="margin-top:1rem">
        <div>
            <label for="al-throttle-input">Throttle Time (seconds)</label>
            <small class="section-desc">Minimum time between proactive responses. Leave empty to use the global default (<%= defaultActiveListeningThrottle %>s).</small>
            <div class="inline-form">
                <input type="number" id="al-throttle-input" min="1" step="1"
                    value="<%= group.active_listening_throttle_ms ? Math.round(group.active_listening_throttle_ms / 1000) : '' %>"
                    placeholder="<%= defaultActiveListeningThrottle %>">
                <button onclick="saveGroupActiveListeningThrottle('<%= group.group_id %>')">Save</button>
            </div>
        </div>
        <div>
            <label for="al-context-count-input">Context Messages</label>
            <small class="section-desc">Recent messages sent to the fast LLM. Leave empty to use the global default (<%= defaultActiveListeningContextCount %>).</small>
            <div class="inline-form">
                <input type="number" id="al-context-count-input" min="1" max="50" step="1"
                    value="<%= group.active_listening_context_count || '' %>"
                    placeholder="<%= defaultActiveListeningContextCount %>">
                <button onclick="saveGroupActiveListeningContextCount('<%= group.group_id %>')">Save</button>
            </div>
        </div>
    </div>

    <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Media Attachments</h5>
    <small class="section-desc">Send audio/image files to the active listener LLM for richer context.</small>

    <label>
        <input type="checkbox" role="switch" id="toggle-active_listening_send_audio"
            data-group="<%= group.group_id %>" data-field="active_listening_send_audio"
            <%= group.active_listening_send_audio != null ? (group.active_listening_send_audio !== 0 ? 'checked' : '') : (defaultAlSendAudio === '1' ? 'checked' : '') %>
            onchange="toggleSetting(this)">
        Send Audio to Active Listener
        <span class="info-icon">i<span class="info-tooltip">Attach recent audio files so the active listener LLM can hear voice messages when deciding whether to respond.</span></span>
    </label>

    <label>
        <input type="checkbox" role="switch" id="toggle-active_listening_send_images"
            data-group="<%= group.group_id %>" data-field="active_listening_send_images"
            <%= group.active_listening_send_images != null ? (group.active_listening_send_images !== 0 ? 'checked' : '') : (defaultAlSendImages === '1' ? 'checked' : '') %>
            onchange="toggleSetting(this)">
        Send Images to Active Listener
        <span class="info-icon">i<span class="info-tooltip">Attach recent images so the active listener LLM can see shared images when deciding whether to respond.</span></span>
    </label>

    <div class="settings-grid" style="margin-top:0.5rem">
        <div>
            <label for="al-audio-count-input">Audio Count</label>
            <small class="section-desc">Number of recent audio messages to attach. Leave empty to use the global default (<%= defaultAlAudioCount %>).</small>
            <div class="inline-form">
                <input type="number" id="al-audio-count-input" min="1" max="10" step="1"
                    value="<%= group.active_listening_audio_count || '' %>"
                    placeholder="<%= defaultAlAudioCount %>">
                <button onclick="saveGroupAlAudioCount('<%= group.group_id %>')">Save</button>
            </div>
        </div>
        <div>
            <label for="al-image-count-input">Image Count</label>
            <small class="section-desc">Number of recent images to attach. Leave empty to use the global default (<%= defaultAlImageCount %>).</small>
            <div class="inline-form">
                <input type="number" id="al-image-count-input" min="1" max="10" step="1"
                    value="<%= group.active_listening_image_count || '' %>"
                    placeholder="<%= defaultAlImageCount %>">
                <button onclick="saveGroupAlImageCount('<%= group.group_id %>')">Save</button>
            </div>
        </div>
    </div>

    <h5 style="margin-top:1.5rem; margin-bottom:0.25rem">Additional Instructions</h5>
    <small class="section-desc">Extra instructions injected into the global decision prompt for this group. These are treated as high priority. Leave empty for no additional instructions.</small>
    <textarea id="al-prompt-editor" class="context-editor" data-group="<%= group.group_id %>" data-save-btn="btn-save-al-prompt" placeholder="e.g. Always respond when someone asks about cooking recipes."><%= group.active_listening_prompt || '' %></textarea>
    <button id="btn-save-al-prompt" onclick="saveGroupActiveListeningPrompt('<%= group.group_id %>')" disabled>Save</button>
    </div>
</article>

<%- include('footer') %>
